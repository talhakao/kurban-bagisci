generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id        Int             @id @default(autoincrement())
  name      String
  slug      String          @unique
  password  String
  donations Donation[]
  groups    DonationGroup[]
  createdAt DateTime        @default(now())
}

model DonationGroup {
  id        Int        @id @default(autoincrement())
  name      String
  ownerId   Int?
  owner     User?      @relation(fields: [ownerId], references: [id])
  isOzet    Boolean    @default(false)
  donations Donation[]
  createdAt DateTime   @default(now())
}

model Donation {
  id          Int            @id @default(autoincrement())
  ownerName   String
  sharesCount Int
  sharesType  String
  country     String
  referenceId Int
  reference   User           @relation(fields: [referenceId], references: [id])
  phone       String?
  notes       String?
  receipt     String         @default("ALINMADI")
  groupId     Int?
  group       DonationGroup? @relation(fields: [groupId], references: [id])
  createdAt   DateTime       @default(now())
}
